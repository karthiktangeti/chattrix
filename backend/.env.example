# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/chatify

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# Server Configuration
PORT=5000
NODE_ENV=development

# Cloudinary Configuration (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend Configuration (Email Service)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ArcJet Configuration (Security)
ARCJET_KEY=your_arcjet_key

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Email Verification
VERIFICATION_EMAIL_SUBJECT=Verify your email
VERIFICATION_BASE_URL=http://localhost:5000
